{
  "manifest_version": 3,
  "name": "YouTube Music Discord Presence",
  "version": "1.1.0",
  "description": "Shows the current YouTube Music track in Discord Rich Presence.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "tabs"
  ],
  "host_permissions": [
    "https://music.youtube.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://music.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}